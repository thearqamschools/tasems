# Copy to .env.prod on the server and fill in. Never commit the real file.
TASEMS_DOMAIN=tasems.example.com
SECRET_KEY=generate-a-long-random-value-of-at-least-50-characters
FIELD_ENCRYPTION_KEY=generate-with-the-command-in-.env.example
DEBUG=False
ALLOWED_HOSTS=tasems.example.com
CSRF_TRUSTED_ORIGINS=https://tasems.example.com
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
POSTGRES_SUPERUSER_PASSWORD=a-different-long-random-password
TASEMS_DB_PASSWORD=another-long-random-password
# Backups
BACKUP_PASSPHRASE_FILE=/root/tasems-backup-passphrase
BACKUP_DIR=/var/backups/tasems
